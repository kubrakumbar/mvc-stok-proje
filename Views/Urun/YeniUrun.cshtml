@model MvcStokProje.Models.Entity.TBLURUNLER
@{
    ViewBag.Title = "YeniUrun";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<form class="form-group" method="post">
    <div>
        @* name alanı ile vt tablo kolon adı aynı olacak!!! *@
        <label>Ürün Adı : </label>
        <input type="text" name="URUNAD" class="form-control" required maxlength="30"/>
    </div>
    <div>
        <label>Marka : </label>
        <input type="text" name="MARKA" class="form-control" value="" required placeholder="marka giriniz"/>
    </div>
    <div>
        <label>Ürün Kategori : </label>
         @Html.DropDownListFor(m => m.TBLKATEGORILER.KATEGORIID, (List<SelectListItem>)ViewBag.dgr, new {@class="form-control"})
   
        @* hata veriyor ! *@
    @*<select class="form-control">
        @foreach (var item in ViewBag.dgr)
        {
            <option value="@item.KATEGORIID">@item.KATEGORIAD</option>
        }
    </select>*@
    </div>
    <div>
        <label>Fiyat : </label>
        <input type="text" name="FIYAT" class="form-control" value="" />
    </div>
    <div>
        <label>Stok : </label>
        <input type="text" name="STOK" class="form-control" value="" />
    </div>

    <div style="margin-top:15px;"><button class=" btn btn-info">Ürün Ekle</button></div>
</form>



