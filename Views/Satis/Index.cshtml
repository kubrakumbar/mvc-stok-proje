@model MvcStokProje.Models.Entity.TBLSATISLAR
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<button class="btn btn-primary" type="button" data-toggle="modal" data-target="#Modal1">
    Satış Yap
</button>
<div class="modal" id="Modal1" >
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">Satış Yapma Ekranı</h2>
            </div>
            <form action="/Satis/YeniSatis" method="post">
                <div class="modal-body">
                    <label>Ürün Adı :</label>
                    @Html.TextBoxFor(m => m.URUN, new { @class = "form-control" })
                    <label>Müşteri Adı Soyadı :</label>
                    @Html.TextBoxFor(m => m.MUSTERI, new { @class = "form-control" })
                    <label>Adet :</label>
                    @Html.TextBoxFor(m => m.ADET, new { @class = "form-control" })
                    <label>Fiyat:</label>
                    @Html.TextBoxFor(m => m.FIYAT, new { @class = "form-control" })
                <button type="submit" class="btn btn-info">Satış işlemini yap</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal">Vazgeç</button>
                </div>
            </form>
        </div>
    </div>
</div>

