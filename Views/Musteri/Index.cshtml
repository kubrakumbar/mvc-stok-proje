@using MvcStokProje.Models.Entity
@model List<TBLMUSTERILER>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
@using (Html.BeginForm("Index", "Musteri", FormMethod.Get))
{
    <p>
        Aranacak Müşteri Adı : @Html.TextBox("p")
        <input type="submit" value="Ara" />
    </p>}
    <table class="table table-bordered">
        <tr>
            <th>Müşteri ID</th>
            <th>Müşteri Adı</th>
            <th>Müşteri Soyad</th>
            <th>SİL</th>
            <th>GÜNCELLE</th>
            <th>ALERT</th>
        </tr>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MUSTERIID</td>
                    <td>@item.MUSTERIAD</td>
                    <td>@item.MUSTERISOYAD</td>
                    <td><a href="/Musteri/Sil/@item.MUSTERIID" class="btn btn-danger">SİL</a></td>
                    <td><a href="/Musteri/MusteriGetir/@item.MUSTERIID" class="btn btn-success">GÜNCELLE</a></td>
                    <td>@Html.ActionLink("SİL BUTONU", "Sil", new { id = item.MUSTERIID }, new { @class = "btn btn-warning", onclick = "return confirm('gerçekten silmek istiyor musunuz ?')" })</td>
                </tr>
            }
        </tbody>
    </table>
    <a href="/Musteri/YeniMusteri/" class="btn btn-primary">YENİ MÜŞTERİ EKLE</a>

