@model MvcStokProje.Models.Entity.TBLMUSTERILER
@{
    ViewBag.Title = "YeniMusteri";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<form class="form-group" method="post">
    <!--<div>-->
        @* name alanı ile vt tablo kolon adı aynı olacak!!! *@
        <!--<label>Müşteri Adı : </label>
        <input type="text" name="MUSTERIAD" class="form-control" value="" />
    </div>-->
    <div>
        <label>Müşteri adı :</label>
        @Html.TextBoxFor(m=>m.MUSTERIAD,new {@class="form-control" })
        @Html.ValidationMessageFor(m=>m.MUSTERIAD,"",new {@style="color:green" })
    </div>
    <div>
        <label>Müşteri Soyadı : </label>
        <input type="text" name="MUSTERISOYAD" class="form-control" value="" />
    </div>
    <div style="margin-top:15px;"><button id="btn1" class=" btn btn-info">Müşteri Ekle</button></div>
    <script>
        $('#btn1').click(function () {
            alert('müşteri ekleme işlemi yapıldı');
        });
    </script>
</form>

